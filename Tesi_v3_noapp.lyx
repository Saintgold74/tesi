\begin_layout Standard

\lang italian
Il Total Cost of Compliance estende il concetto di TCO includendo costi diretti, indiretti e di opportunità²¹:
\end_layout

\begin_layout Verbatim
TCC = Σₜ [(DC_t + IC_t + OC_t + RC_t) / (1+r)^t]
\end_layout

\begin_layout Standard

\lang italian
dove: - DC_t = Costi diretti (personale, tecnologia, consulenza) - IC_t = Costi indiretti (inefficienze, overhead) - OC_t = Costi opportunità (progetti rinviati) - RC_t = Costi di rischio (sanzioni potenziali × probabilità) - r = WACC (Weighted Average Cost of Capital)
\end_layout

\begin_layout Standard

\lang italian
L'analisi su 5 anni per organizzazione GDO media (€500M fatturato)²²:
\end_layout

\begin_layout Standard

\lang italian

\series bold
Approccio Tradizionale
\series default
: - DC: €2.3M/anno - IC: €1.1M/anno
\begin_inset Newline newline
\end_inset

 - OC: €0.8M/anno - RC: €1.7M/anno - TCC₅: €23.4M (NPV)
\end_layout

\begin_layout Standard

\lang italian

\series bold
Approccio Integrato
\series default
: - DC: €1.8M/anno (-22%) - IC: €0.4M/anno (-64%) - OC: €0.3M/anno (-63%) - RC: €0.4M/anno (-76%) - TCC₅: €11.7M (NPV)
\end_layout

\begin_layout Standard

\lang italian
Riduzione TCC: 50.0% (IC 95%: 46.3%-53.7%)
\end_layout

